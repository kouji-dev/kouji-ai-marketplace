Output "scene-1.mp4"
Set Shell "pwsh"
Set FontSize 30
Set Width 1920
Set Height 1200
Set Padding 40
Set Framerate 15
Set TypingSpeed 45ms
Set CursorBlink false
Hide
Type ". C:/world/world.ps1; cls"
Enter
Sleep 1s
Show
Type "/extensions"
Sleep 900ms
Enter
Sleep 400ms
Sleep 400ms
Hide
Wait+Screen@30s /listed/
Show
Sleep 800ms
Sleep 1000ms
Down 20
Sleep 400ms
Sleep 600ms
Type "i"
Sleep 400ms
Sleep 400ms
Hide
Wait+Screen@30s /It asks for/
Show
Sleep 800ms
Sleep 1800ms
Enter
Sleep 400ms
Sleep 400ms
Hide
Wait+Screen@30s /1 installed/
Show
Sleep 800ms
Sleep 1200ms
Hide
Sleep 4s
Show
Escape
Sleep 1000ms
Escape
Sleep 1000ms
Type "/extensions reload"
Sleep 900ms
Enter
Sleep 400ms
Sleep 400ms
Hide
Wait+Screen@30s /Attached/
Show
Sleep 800ms
Sleep 2500ms
